{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "url": {
      "type": "string",
      "description": "Product website URL"
    },
    "image": {
      "type": "string",
      "description": "Product image URL"
    },
    "icon_name": {
      "type": "string",
      "description": "Lucide icon name (Shield, Leaf, Heart, Sun, Newspaper, etc)"
    },
    "color": {
      "type": "string",
      "description": "Gradient color classes (e.g., from-blue-500 to-indigo-500)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "category",
    "url"
  ]
}